# Upstox API credentials (https://api.upstox.com/developer/apps)
UPSTOX_API_KEY=your_api_key_here
UPSTOX_API_SECRET=your_api_secret_here

# OAuth Redirect URI: must exactly match what you configured in Upstox Developer Console
# Local: http://127.0.0.1:8000/callback
# OCI Server: http://<YOUR_OCI_PUBLIC_IP>:8000/callback (or https://yourdomain.com/callback)
UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/callback

# Server Host & Port (0.0.0.0 allows external access on cloud servers)
HOST=0.0.0.0
PORT=8000
